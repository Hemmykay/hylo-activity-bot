# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/hylo_support"

# ─── Discord ─────────────────────────────────────────────────────────────────
DISCORD_TOKEN="your-discord-bot-token"
DISCORD_CLIENT_ID="your-discord-application-client-id"
# Comma-separated Discord user IDs allowed to use the bot
ALLOWED_USER_IDS="123456789012345678,234567890123456789"
# Discord role ID required to use the bot, in addition to ALLOWED_USER_IDS.
# For DMs, membership is checked against the guild that owns MINT_ALERTS_CHANNEL_ID.
REQUIRED_ROLE_ID="123456789012345678"

# ─── AI Provider Chain ───────────────────────────────────────────────────────
# Ordered comma-separated list of providers. Tried left-to-right on failure.
# Valid values: claude, gemini, openrouter
# Each provider listed here must have its corresponding API key set below.
AI_PROVIDER_CHAIN="claude,gemini,openrouter"

# Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini
GOOGLE_AI_API_KEY="AIza..."

# OpenRouter (last-resort — access to 200+ models via one API)
OPENROUTER_API_KEY="sk-or-v1-..."
# Optional model override (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=""

# ─── Local LLM via Ollama ─────────────────────────────────────────────────────
# Add "ollama" to AI_PROVIDER_CHAIN to use a local model (no API key needed).
# Install: https://ollama.ai  |  Pull model: ollama pull gemma3:4b
# Ollama runs entirely on your machine — no internet, no cost, fully private.
#
# Recommended models:
#   gemma3:4b        — Google Gemma 3 (fast, good for support tasks)
#   gemma3:27b       — More capable, needs ~20GB RAM
#   llama3.2:3b      — Very fast, good for quick tasks
#   phi4:latest      — Microsoft Phi-4 (strong reasoning)
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="gemma3:4b"

# ─── AI Model Overrides (optional) ───────────────────────────────────────────
# Leave blank to use defaults defined in the provider
CLAUDE_MODEL=""
GEMINI_MODEL=""

# ─── Mint Watcher ─────────────────────────────────────────────────────────────
# Optional — the background mint/stake/offload watcher and daily summary are
# disabled until this is set.
MINT_ALERTS_CHANNEL_ID=""
# Minimum USD value a mint/stake must reach to actually post a live alert.
# Default 0 — report everything. Never gates the daily summary, which always
# accounts for every mint/burn regardless of size.
MIN_VAL_REPORT="0"
# Optional — the eHYUSD cap-progress milestone poster is disabled until this is set.
EHYUSD_CAP_CHANNEL_ID=""

# Helius — Solana on-chain data (required for the mint watcher / on-chain queries)
HELIUS_API_KEY=""

# ─── Hylo Public API v1 (https://api.hylo.so/docs) ────────────────────────────
# Primary source for the mint-watcher event stream and asset pricing. Helius
# RPC stays wired in as the automatic fallback (feed failures, a stalled
# indexer, or this kill switch flip the watcher back to RPC scanning). No
# configuration is needed to use it — both settings are optional.
# HYLO_API_BASE_URL=""            # defaults to https://api.hylo.so
# HYLO_V1_EVENTS_DISABLED=""      # set to 1 to force pure-RPC event scanning

# ─── X (Twitter) ──────────────────────────────────────────────────────────────
# Optional — posting is disabled until all four of these are set. Only the
# daily mint/burn summary posts here, never live alerts (X's write-API rate
# limits don't tolerate that volume). Needs a paid API tier ("Basic" or
# higher) — the free tier is read-only and can't post.
# App permissions must be "Read and Write" — set that BEFORE generating these
# tokens, since a token's write permission is fixed at generation time.
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_TOKEN_SECRET=""
# Minimum |net USD| the daily summary must reach to also post to X. Default 0
# — post every day. A day whose net value can't be resolved never posts to X.
TWITTER_MIN_NET_USD="0"

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="info"

# Minimum confidence score (0–1) to use FAQ-based answer without warning
FAQ_CONFIDENCE_THRESHOLD="0.65"

# How long (minutes) a pending confirmation stays valid before expiry
PENDING_ACTION_TTL_MINUTES="30"
